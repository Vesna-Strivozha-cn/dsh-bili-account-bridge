{
  "name": "dsh-bili-account-bridge",
  "version": "0.1.4",
  "description": "B站桥：让 dsh-bili-whale（养鱼）与 dsh-dafeiyu-life（大肥鱼）共用一份登录态；收到文本先在插件内打分定倾向（偏养鱼的归养鱼，其余归大肥鱼），再按闸门决定谁回，两边不抢同一句。",
  "type": "module",
  "main": "index.js",
  "exports": {
    "./index.js": "./index.js",
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "bilibili",
    "credential",
    "bridge",
    "account"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Vesna-Strivozha-cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge.git"
  },
  "homepage": "https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge#readme",
  "bugs": {
    "url": "https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge/issues"
  },
  "peerDependencies": {
    "dsh-bili-whale": "*",
    "dsh-dafeiyu-life": "*"
  },
  "peerDependenciesMeta": {
    "dsh-bili-whale": {
      "optional": true
    },
    "dsh-dafeiyu-life": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
