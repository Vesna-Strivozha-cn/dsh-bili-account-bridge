{
  "name": "dsh-bili-account-bridge",
  "version": "0.1.5",
  "description": "B站桥：养鱼（dsh-bili-whale）与大肥鱼（dsh-dafeiyu-life）共用一份 B站 登录态；每条消息先按共享词库定归属，再由两侧闸门决定谁动、谁静默，同一句只回一次。",
  "type": "module",
  "main": "index.js",
  "exports": {
    "./index.js": "./index.js",
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "bilibili",
    "credential",
    "bridge",
    "account"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Vesna-Strivozha-cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge.git"
  },
  "homepage": "https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge#readme",
  "bugs": {
    "url": "https://github.com/Vesna-Strivozha-cn/dsh-bili-account-bridge/issues"
  },
  "peerDependencies": {
    "dsh-bili-whale": "*",
    "dsh-dafeiyu-life": "*"
  },
  "peerDependenciesMeta": {
    "dsh-bili-whale": {
      "optional": true
    },
    "dsh-dafeiyu-life": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  }
}
